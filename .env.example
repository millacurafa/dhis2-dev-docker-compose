# Copy to .env and adjust: cp .env.example .env

# dhis2/core-dev tag. `latest` follows the newest dev build (2.44).
# To pin a build: DHIS2_TAG=latest@sha256:<digest>
DHIS2_TAG=latest

# Official PostGIS image tag and platform (the official image is amd64-only)
POSTGIS_TAG=16-3.5
DB_PLATFORM=linux/amd64

REDIS_TAG=7

# Leave empty for a random password (generated on first start, stored in the db_password volume).
# Set a value to choose your own. Only applies on first start.
DB_PASSWORD=

SERVER_BASE_URL=http://localhost:8080

GLOWROOT_VERSION=0.14.2

# Optional: URL of a .sql.gz dump loaded on first start (leave empty for an empty DB)
DHIS2_DB_DUMP_URL=
# DHIS2_DB_DUMP_URL=https://databases.dhis2.org/sierra-leone/2.42.0/dhis2-db-sierra-leone.sql.gz
